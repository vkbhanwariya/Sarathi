{
  "manifest_version": "2.1.0",
  "system": "sarathi",
  "source_root": "src",
  "root_package": "sarathi",
  "root_components": [
    "__main__"
  ],
  "dependency_policy": {
    "default_internal_policy": "deny"
  },
  "modules": {
    "dosh": {
      "package": "sarathi.dosh",
      "role": "shared-error-types",
      "components": [
        "errors"
      ],
      "may_import": []
    },
    "sankalpa": {
      "package": "sarathi.sankalpa",
      "role": "shared-contracts-and-document-models",
      "components": [
        "artifact",
        "cancellation",
        "capability",
        "context",
        "document",
        "execution_profile",
        "plugin",
        "readiness",
        "request",
        "result"
      ],
      "may_import": [
        "sarathi.dosh"
      ]
    },
    "kavacha": {
      "package": "sarathi.kavacha",
      "role": "security-authorization-and-path-privacy-checks",
      "components": [
        "policy",
        "service"
      ],
      "may_import": [
        "sarathi.dosh",
        "sarathi.sankalpa"
      ]
    },
    "darpana": {
      "package": "sarathi.darpana",
      "role": "runtime-and-quality-events-history",
      "components": [
        "history",
        "maruti",
        "pramana",
        "service"
      ],
      "may_import": [
        "sarathi.dosh",
        "sarathi.sankalpa"
      ]
    },
    "smriti": {
      "package": "sarathi.smriti",
      "role": "optional-result-cache",
      "components": [
        "key",
        "memory",
        "policy",
        "serialization",
        "store"
      ],
      "may_import": [
        "sarathi.dosh",
        "sarathi.sankalpa"
      ]
    },
    "yantra": {
      "package": "sarathi.yantra",
      "role": "execution-and-device-helpers",
      "components": [
        "devices",
        "manager",
        "resources"
      ],
      "may_import": [
        "sarathi.dosh",
        "sarathi.sankalpa",
        "sarathi.darpana"
      ]
    },
    "sutra": {
      "package": "sarathi.sutra",
      "role": "runtime-settings",
      "components": [
        "loader",
        "settings"
      ],
      "may_import": [
        "sarathi.dosh",
        "sarathi.sankalpa",
        "sarathi.darpana"
      ]
    },
    "nabhi": {
      "package": "sarathi.nabhi",
      "role": "runtime-namespace-for-registry-planning-execution-and-artifacts",
      "components": [
        "artifacts",
        "kosh",
        "manthan",
        "pravaha",
        "quarantine"
      ],
      "may_import": [
        "sarathi.dosh",
        "sarathi.sankalpa",
        "sarathi.kavacha",
        "sarathi.darpana",
        "sarathi.smriti",
        "sarathi.yantra"
      ]
    },
    "shakti": {
      "package": "sarathi.shakti",
      "role": "document-processing-capabilities-and-provider-adapters",
      "components": [
        "artifact_naming",
        "azure",
        "bank_statements",
        "darshana",
        "docx_exporter",
        "font_conversion",
        "gemini",
        "mistral",
        "native_extraction",
        "ocr",
        "providers",
        "statutory",
        "text",
        "translation"
      ],
      "may_import": [
        "sarathi.dosh",
        "sarathi.sankalpa",
        "sarathi.darpana",
        "sarathi.sutra",
        "sarathi.yantra"
      ]
    },
    "mukha": {
      "package": "sarathi.mukha",
      "role": "presentation-local-web-transport-and-ui-state",
      "components": [
        "intake",
        "presenter",
        "state",
        "web"
      ],
      "may_import": [
        "sarathi.dosh",
        "sarathi.sankalpa",
        "sarathi.kavacha",
        "sarathi.darpana",
        "sarathi.sutra",
        "sarathi.agni"
      ]
    },
    "agni": {
      "package": "sarathi.agni",
      "role": "application-composition-and-process-lifecycle",
      "components": [
        "bootstrap",
        "dispatcher",
        "preflight",
        "readiness",
        "wiring"
      ],
      "composition_root": true,
      "may_import": [
        "sarathi.darpana",
        "sarathi.dosh",
        "sarathi.kavacha",
        "sarathi.nabhi",
        "sarathi.sankalpa",
        "sarathi.shakti",
        "sarathi.smriti",
        "sarathi.sutra",
        "sarathi.yantra"
      ]
    }
  },
  "groups": {
    "shakti_plugins": {
      "members": [
        "sarathi.shakti.bank_statements",
        "sarathi.shakti.darshana",
        "sarathi.shakti.font_conversion",
        "sarathi.shakti.native_extraction",
        "sarathi.shakti.ocr",
        "sarathi.shakti.translation",
        "sarathi.shakti.mistral",
        "sarathi.shakti.gemini",
        "sarathi.shakti.azure",
        "sarathi.shakti.statutory"
      ],
      "mutually_independent": false
    }
  },
  "exceptions": []
}
