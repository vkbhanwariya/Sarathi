{
  "manifest_version": "2.0.0",
  "system": "sarathi",
  "source_root": "src",
  "root_package": "sarathi",
  "dependency_policy": {
    "default_internal_policy": "allow"
  },
  "modules": {
    "dosh": {
      "package": "sarathi.dosh",
      "role": "shared-error-types",
      "may_import": []
    },
    "sankalpa": {
      "package": "sarathi.sankalpa",
      "role": "shared-contracts-and-document-models",
      "may_import": [
        "sarathi.dosh"
      ]
    },
    "kavacha": {
      "package": "sarathi.kavacha",
      "role": "security-authorization-and-path-privacy-checks",
      "may_import": [
        "sarathi.dosh",
        "sarathi.sankalpa"
      ]
    },
    "darpana": {
      "package": "sarathi.darpana",
      "role": "runtime-and-quality-events-history",
      "may_import": [
        "sarathi.dosh",
        "sarathi.sankalpa"
      ]
    },
    "smriti": {
      "package": "sarathi.smriti",
      "role": "optional-result-cache",
      "may_import": [
        "sarathi.dosh",
        "sarathi.sankalpa"
      ]
    },
    "yantra": {
      "package": "sarathi.yantra",
      "role": "execution-and-device-helpers",
      "may_import": [
        "sarathi.dosh",
        "sarathi.sankalpa",
        "sarathi.darpana"
      ]
    },
    "sutra": {
      "package": "sarathi.sutra",
      "role": "runtime-settings",
      "may_import": [
        "sarathi.dosh",
        "sarathi.sankalpa",
        "sarathi.darpana",
        "sarathi.kavacha",
        "sarathi.smriti"
      ]
    },
    "nabhi": {
      "package": "sarathi.nabhi",
      "role": "pipeline-execution-and-capability-resolution",
      "may_import": [
        "*"
      ]
    },
    "shakti": {
      "package": "sarathi.shakti",
      "role": "document-processing-capabilities-and-provider-adapters",
      "may_import": [
        "*"
      ]
    },
    "mukha": {
      "package": "sarathi.mukha",
      "role": "user-interface",
      "may_import": [
        "*"
      ]
    },
    "agni": {
      "package": "sarathi.agni",
      "role": "application-composition-and-startup",
      "composition_root": true,
      "may_import": [
        "*"
      ]
    }
  },
  "groups": {
    "shakti_plugins": {
      "members": [
        "sarathi.shakti.bank_statements",
        "sarathi.shakti.darshana",
        "sarathi.shakti.font_conversion",
        "sarathi.shakti.native_extraction",
        "sarathi.shakti.ocr",
        "sarathi.shakti.translation",
        "sarathi.shakti.mistral",
        "sarathi.shakti.gemini",
        "sarathi.shakti.azure",
        "sarathi.shakti.bhashini"
      ],
      "mutually_independent": false
    }
  },
  "exceptions": []
}
