{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sarathi Architecture Manifest Schema",
  "description": "Schema defining canonical production topology, ownership, and dependency declarations for Sarathi.",
  "type": "object",
  "required": [
    "manifest_version",
    "system",
    "source_root",
    "root_package",
    "root_components",
    "dependency_policy",
    "modules",
    "groups",
    "exceptions"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "system": {
      "type": "string",
      "enum": ["sarathi"]
    },
    "source_root": {
      "type": "string"
    },
    "root_package": {
      "type": "string"
    },
    "root_components": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "dependency_policy": {
      "type": "object",
      "required": ["default_internal_policy"],
      "additionalProperties": false,
      "properties": {
        "default_internal_policy": {
          "type": "string",
          "enum": ["deny", "allow"]
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["package", "role", "components", "may_import"],
        "additionalProperties": false,
        "properties": {
          "package": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "composition_root": {
            "type": "boolean"
          },
          "may_import": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["members", "mutually_independent"],
        "additionalProperties": false,
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "mutually_independent": {
            "type": "boolean"
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "reason"],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "uniqueItems": true
    }
  }
}
